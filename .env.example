# Google AdSense — optional; ads render only when BOTH are set.
# Client id from AdSense dashboard (ca-pub-…), slot id from the display ad unit.
# NEXT_PUBLIC_ADSENSE_CLIENT=
# NEXT_PUBLIC_ADSENSE_SLOT=

# Sentry — error monitoring. Empty = off (dev, CI, e2e).
# DSN from the Sentry project's Client Keys page.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Auth token for source map uploads (Vercel production only).
SENTRY_AUTH_TOKEN=
